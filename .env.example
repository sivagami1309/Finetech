# FinGuard – TrustFlow Environment Configuration Template
# Copy this file to .env and supply your environment variables.
# NEVER commit real credentials to source control.

# Server Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
# Option 1: Standard PostgreSQL Connection String
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/finguard_trustflow

# Option 2: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password_here
PGDATABASE=finguard_trustflow
PGSSLMODE=disable

# Authentication & Session Security
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_production
JWT_EXPIRES_IN=7d
COOKIE_SETTINGS={"httpOnly":true,"secure":false,"sameSite":"lax"}

# Polygon Amoy Testnet Blockchain Attestation
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
POLYGON_AMOY_CHAIN_ID=80002
CONTRACT_ADDRESS=0x217d83E71c5324D69B0C522B2945dC3806Fa6a85
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
