# FinGuard - TrustFlow Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Neon or Supabase)
# Example: postgresql://postgres:yourpassword@db.supabase.co:5432/postgres
# When empty in local dev, an embedded PostgreSQL pool with automated migrations is used
DATABASE_URL=

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_production
JWT_EXPIRES_IN=7d
COOKIE_SETTINGS={"httpOnly":true,"secure":false,"sameSite":"lax"}

# Blockchain Configuration (Polygon Amoy Testnet)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
POLYGON_AMOY_CHAIN_ID=80002
CONTRACT_ADDRESS=0x217d83E71c5324D69B0C522B2945dC3806Fa6a85
# Dedicated test wallet private key for backend-signed transactions (Never commit real keys!)
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
